class Garagem:
    def __init__(self):
        self.carros = []

        for i in range(1, 21):
            self.carros.append(f"Carro {i}")

    def mostrar_carros(self):
        print("\nCarros na garagem:")

        for carro in self.carros:
            print(carro)

    def retirar_carro(self, carro_desejado):
        if carro_desejado not in self.carros:
            print("Carro não encontrado.")
            return

        retirados = []

        while self.carros[-1] != carro_desejado:
            carro = self.carros.pop()
            retirados.append(carro)

        carro = self.carros.pop()
        retirados.append(carro)

        print("\nCarros retirados:")

        for carro in retirados:
            print(carro)


garagem = Garagem()

garagem.mostrar_carros()

carro = input("\nDigite o carro que deseja retirar: ")

garagem.retirar_carro(carro)
