import collections

def adicionar_inicio(fila):
    nome = input("Digite o nome do viajante: ")
    fila.appendleft(nome)
    print("Viajante adicionado no início da fila.")

def adicionar_final(fila):
    nome = input("Digite o nome do viajante: ")
    fila.append(nome)
    print("Viajante adicionado no final da fila.")

def enviar_inicio(fila):
    if len(fila) == 0:
        print("A fila está vazia.")
    else:
        nome = fila.popleft()
        print(nome, "foi enviado para a missão.")

def enviar_final(fila):
    if len(fila) == 0:
        print("A fila está vazia.")
    else:
        nome = fila.pop()
        print(nome, "foi enviado para a missão.")

def apresentar_fila(fila):
    if len(fila) == 0:
        print("A fila está vazia.")
    else:
        print("Viajantes na fila:")
        for nome in fila:
            print(nome)

def main():
    fila = collections.deque()
    opcao = 0

    while opcao != 6:
        print("\n--- MENU ---")
        print("1 - Adicionar viajante no início da fila")
        print("2 - Adicionar viajante no final da fila")
        print("3 - Enviar viajante do início para a missão")
        print("4 - Enviar viajante do final para a missão")
        print("5 - Apresentar fila de viajantes")
        print("6 - Sair")

        opcao = int(input("Digite uma opção: "))

        if opcao == 1:
            adicionar_inicio(fila)

        elif opcao == 2:
            adicionar_final(fila)

        elif opcao == 3:
            enviar_inicio(fila)

        elif opcao == 4:
            enviar_final(fila)

        elif opcao == 5:
            apresentar_fila(fila)

        elif opcao == 6:
            print("Programa encerrado.")

        else:
            print("Opção inválida.")

main()
