class SuporteTI:
    def __init__(self):
        self.fila = []

    def adicionar_chamado(self, nome):
        self.fila.append(nome)
        print(f"Chamado de {nome} adicionado.")

    def atender_chamado(self):
        if len(self.fila) > 0:
            nome = self.fila.pop(0)

            print(f"Atendendo: {nome}")
            print(f"Chamados aguardando: {len(self.fila)}")

            if len(self.fila) > 0:
                print(f"Próximo: {self.fila[0]}")
            else:
                print("Não há mais chamados.")
        else:
            print("A fila está vazia.")

    def mostrar_fila(self):
        if len(self.fila) > 0:
            print("\nChamados aguardando:")

            for nome in self.fila:
                print(nome)

            print(f"Total: {len(self.fila)}")
            print(f"Próximo: {self.fila[0]}")
        else:
            print("A fila está vazia.")


suporte = SuporteTI()

while True:
    print("\n--- SUPORTE DE TI ---")
    print("1 - Registrar chamado")
    print("2 - Atender chamado")
    print("3 - Mostrar fila")
    print("4 - Sair")

    opcao = input("Escolha: ")

    if opcao == "1":
        nome = input("Nome da pessoa: ")
        suporte.adicionar_chamado(nome)

    elif opcao == "2":
        suporte.atender_chamado()

    elif opcao == "3":
        suporte.mostrar_fila()

    elif opcao == "4":
        print("Programa encerrado.")
        break

    else:
        print("Opção inválida.")
