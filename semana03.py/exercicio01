class No:
    def __init__(self, info):
        self.info = info
        self.prox = None


def inserir(lst, valor):
    novo = No(valor)

    if lst == None:
        return novo

    atual = lst

    while atual.prox != None:
        atual = atual.prox

    atual.prox = novo
    return lst


def listar(lst):
    if lst == None:
        print("Lista vazia.")
        return

    atual = lst

    while atual != None:
        print(atual.info)
        atual = atual.prox


def remover(lst, valor):
    if lst == None:
        print("Lista vazia.")
        return lst

    if lst.info == valor:
        return lst.prox

    atual = lst

    while atual.prox != None:
        if atual.prox.info == valor:
            atual.prox = atual.prox.prox
            return lst

        atual = atual.prox

    print("Valor não encontrado.")
    return lst


# Lista encadeada
lst = None

while True:
    print("\n1. Inserir item")
    print("2. Listar itens")
    print("3. Remover item")
    print("0. Sair")

    opcao = int(input("Escolha uma opção: "))

    if opcao == 1:
        valor = float(input("Digite o valor: "))
        lst = inserir(lst, valor)

    elif opcao == 2:
        listar(lst)

    elif opcao == 3:
        valor = float(input("Digite o valor que deseja remover: "))
        lst = remover(lst, valor)

    elif opcao == 0:
        print("Programa encerrado.")
        break

    else:
        print("Opção inválida.")
