class PilhaOperacoes:
    def __init__(self):
        self.pilha = []

    def inserir(self, operacao):
        self.pilha.append(operacao)
        print("Operação adicionada.")

    def retirar(self):
        if len(self.pilha) > 0:
            operacao = self.pilha.pop()
            print(f"Operação removida: {operacao}")
        else:
            print("A pilha está vazia.")

    def mostrar_topo(self):
        if len(self.pilha) > 0:
            print(f"Topo da pilha: {self.pilha[-1]}")
        else:
            print("A pilha está vazia.")

    def mostrar_todas(self):
        if len(self.pilha) > 0:
            print("\nOperações pendentes:")

            for operacao in reversed(self.pilha):
                print(operacao)
        else:
            print("A pilha está vazia.")


operacoes = PilhaOperacoes()

while True:
    print("\n--- PILHA DE OPERAÇÕES ---")
    print("1 - Inserir operação")
    print("2 - Retirar última operação")
    print("3 - Mostrar última operação")
    print("4 - Mostrar operações pendentes")
    print("5 - Sair")

    opcao = input("Escolha: ")

    if opcao == "1":
        operacao = input("Digite a operação: ")
        operacoes.inserir(operacao)

    elif opcao == "2":
        operacoes.retirar()

    elif opcao == "3":
        operacoes.mostrar_topo()

    elif opcao == "4":
        operacoes.mostrar_todas()

    elif opcao == "5":
        print("Programa encerrado.")
        break

    else:
        print("Opção inválida.")
