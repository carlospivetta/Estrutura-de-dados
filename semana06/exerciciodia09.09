class Atleta:
    def __init__(self, id, bastao=False):
        self.id = id
        self.bastao = bastao
        self.proximo = None


class Time:
    def __init__(self):
        self.inicio = None

    
    def adicionar(self, id, bastao=False):
        novo = Atleta(id, bastao)

        if self.inicio is None:
            self.inicio = novo
            novo.proximo = novo
        else:
            atual = self.inicio

            while atual.proximo != self.inicio:
                atual = atual.proximo

            atual.proximo = novo
            novo.proximo = self.inicio

    
    def remover(self, id):
        if self.inicio is None:
            return

        atual = self.inicio
        anterior = None

        while True:
            if atual.id == id:
                break

            anterior = atual
            atual = atual.proximo

            if atual == self.inicio:
                print("Atleta não encontrado.")
                return

        if atual.proximo == atual:
            self.inicio = None

       
        elif atual == self.inicio:
            ultimo = self.inicio

            while ultimo.proximo != self.inicio:
                ultimo = ultimo.proximo

            self.inicio = atual.proximo
            ultimo.proximo = self.inicio

        else:
            anterior.proximo = atual.proximo

   
    def mostrar(self):
        if self.inicio is None:
            print("Time vazio.")
            return

        atual = self.inicio

        while True:
            print(
                "Atleta:", atual.id,
                "| Bastão:", atual.bastao
            )

            atual = atual.proximo

            if atual == self.inicio:
                break

   
    def simular(self, turnos):
        if self.inicio is None:
            return

        atual = self.inicio

        for i in range(turnos):
            
            atleta = self.inicio

            while True:
                atleta.bastao = False
                atleta = atleta.proximo

                if atleta == self.inicio:
                    break

            
            atual.bastao = True

            print(
                "Turno", i + 1,
                "- Atleta", atual.id,
                "está com o bastão."
            )

            
            atual = atual.proximo


time = Time()

time.adicionar(1, True)
time.adicionar(2)
time.adicionar(3)
time.adicionar(4)
time.adicionar(5)

print("ATLETAS DO TIME:")
time.mostrar()

print("\nSIMULAÇÃO:")
time.simular(10)

print("\nREMOVENDO O ATLETA 3:")
time.remover(3)

print("\nATLETAS APÓS A REMOÇÃO:")
time.mostrar()
