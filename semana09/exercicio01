
from collections import deque

fila = deque()

while True:
    print("\n===== CHAMADOS DE TI =====")
    print("1 - Adicionar chamado comum")
    print("2 - Adicionar chamado urgente")
    print("3 - Atender chamado do início")
    print("4 - Atender chamado do fim")
    print("5 - Listar chamados")
    print("6 - Sair")

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        chamado = input("Digite o chamado: ")
        fila.append(chamado)
        print("Chamado adicionado!")

    elif opcao == "2":
        chamado = input("Digite o chamado urgente: ")
        fila.appendleft(chamado)
        print("Chamado urgente adicionado!")

    elif opcao == "3":
        if len(fila) > 0:
            print("Atendido:", fila[0])
            del fila[0]
        else:
            print("Fila vazia!")

    elif opcao == "4":
        if len(fila) > 0:
            print("Atendido:", fila[-1])
            del fila[-1]
        else:
            print("Fila vazia!")

    elif opcao == "5":
        if len(fila) > 0:
            for chamado in fila:
                print(chamado)
        else:
            print("Fila vazia!")

    elif opcao == "6":
        print("Saindo do sistema...")
        break

    else:
        print("Opção inválida!")
