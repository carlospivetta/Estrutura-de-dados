class No:
    def __init__(self, info):
        self.info = info
        self.prox = None


def maiores(lst, n):
    cont = 0
    p = lst

    while p != None:
        if p.info > n:
            cont += 1
        p = p.prox

    return cont


# lista: 10 -> 25 -> 30 -> 5
lst = No(10)
lst.prox = No(25)
lst.prox.prox = No(30)
lst.prox.prox.prox = No(5)

n = int(input("Digite um valor: "))

resultado = maiores(lst, n)

print("Quantidade de valores maiores:", resultado)
